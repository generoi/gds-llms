#. translators: %s: currency code, e.g. EUR
#: src/Integrations/WooCommerce.php:23
#, php-format
msgid "Products can be bought online. Prices are in %s and include VAT."
msgstr "Tuotteita voi ostaa verkossa. Hinnat ovat valuutassa %s ja sisältävät arvonlisäveron."

#. translators: %s: currency code, e.g. EUR
#: src/Integrations/WooCommerce.php:25
#, php-format
msgid "Products can be bought online. Prices are in %s and exclude VAT."
msgstr "Tuotteita voi ostaa verkossa. Hinnat ovat valuutassa %s ilman arvonlisäveroa."

#. translators: 1: number of products, 2: list of category links
