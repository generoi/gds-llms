{
    "name": "generoi/gds-llms",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "description": "Serves /llms.txt and a markdown version of every page for language models",
    "homepage": "https://github.com/generoi/gds-llms",
    "authors": [
        {
            "name": "Genero",
            "email": "info@genero.fi"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "league/html-to-markdown": "^5.1"
    },
    "suggest": {
        "ext-intl": "Names languages in English (\"Swedish (Finland)\") rather than by locale code"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "php-stubs/woocommerce-stubs": "^9.0",
        "php-stubs/wordpress-seo-stubs": "^20.5",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-phpunit/wp-phpunit": "^7.0",
        "wpsyntex/polylang-stubs": "^3.4",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GeneroWP\\Llms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeneroWP\\Llms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "phpunit",
        "test:wp-env": "npx wp-env run tests-cli --env-cwd=wp-content/mu-plugins/gds-llms php -d memory_limit=1024M vendor/bin/phpunit",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
